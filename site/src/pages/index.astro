---
import Base from '../layouts/Base.astro';

const install =
  'curl -fsSL https://raw.githubusercontent.com/sovereign-cognitive-identity/sci/main/scripts/install.sh | bash';

const props = [
  {
    title: 'Privacy proxy',
    body: 'Your name, email, and other PII are replaced with stable placeholder tokens before any request leaves your machine — and restored in the reply. Anthropic never sees the real values.',
  },
  {
    title: 'Persistent memory',
    body: 'An MCP server gives Claude Code a memory of you, your projects, and past decisions. Context carries across sessions instead of starting cold every time.',
  },
  {
    title: 'Sovereign by default',
    body: 'Your data lives on your machine in local SQLite. Embeddings are computed locally — no per-query data sent to a third party.',
  },
];
---

<Base title="Sci">
  <section class="hero">
    <div class="badge">Alpha v0.1.0 · macOS · Apple Silicon</div>
    <h1>The proxy between you<br />and every AI you use.</h1>
    <p class="lede">
      Sci sits between Claude Code and Anthropic. It protects your privacy by anonymizing PII
      in-flight, and preserves your context with a persistent, local-first memory.
    </p>
    <div class="cta-row">
      <a class="btn primary" href="/install">Install the alpha</a>
      <a class="btn ghost" href="/what-is-sci">What is Sci?</a>
    </div>
    <div class="install-box">
      <span class="prompt">$</span>
      <code>{install}</code>
    </div>
  </section>

  <section class="props">
    {props.map((p) => (
      <div class="prop">
        <h3>{p.title}</h3>
        <p>{p.body}</p>
      </div>
    ))}
  </section>

  <section class="teaser">
    <h2>How it works</h2>
    <p>
      Claude Code's <code>HTTPS_PROXY</code> points at the local <code>sci-helper</code> on port 3001.
      Every request takes a round trip — anonymize, forward to Anthropic, deanonymize the reply —
      while a local agent backs the memory tools over MCP.
    </p>
    <a class="text-link" href="/how-it-works">See the architecture →</a>
  </section>

  <style>
    .hero { padding: 56px 0 40px; max-width: 820px; }
    .badge {
      display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.04em;
      color: var(--accent); background: var(--panel-2); border: 1px solid var(--border-accent);
      border-radius: 999px; padding: 5px 14px; margin-bottom: 22px;
    }
    .hero h1 { font-size: 48px; line-height: 1.1; font-weight: 800; color: #f8fafc; letter-spacing: -0.03em; margin-bottom: 20px; }
    .lede { font-size: 19px; color: var(--text-dim); margin-bottom: 28px; max-width: 640px; }
    .cta-row { display: flex; gap: 14px; margin-bottom: 32px; flex-wrap: wrap; }
    .btn { display: inline-block; padding: 11px 22px; border-radius: 10px; font-weight: 600; font-size: 15px; text-decoration: none; transition: all 0.15s; }
    .btn.primary { background: var(--accent-strong); color: #04263a; }
    .btn.primary:hover { background: var(--accent); }
    .btn.ghost { color: var(--text); border: 1px solid var(--border-accent); }
    .btn.ghost:hover { background: var(--panel-2); }
    .install-box {
      display: flex; align-items: center; gap: 10px;
      background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
      padding: 14px 16px; overflow-x: auto;
    }
    .install-box .prompt { color: var(--green); font-family: "SF Mono", Menlo, monospace; }
    .install-box code { background: none; color: #93c5fd; padding: 0; font-size: 13px; white-space: nowrap; }

    .props { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 24px 0 56px; }
    .prop { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 22px; }
    .prop h3 { font-size: 16px; color: var(--accent); margin-bottom: 8px; }
    .prop p { font-size: 14px; color: var(--text-dim); }

    .teaser { max-width: 720px; }
    .teaser h2 { font-size: 22px; color: #f1f5f9; margin-bottom: 12px; }
    .teaser p { color: #cbd5e1; margin-bottom: 12px; }
    .text-link { color: var(--accent); text-decoration: none; font-weight: 600; }
    .text-link:hover { text-decoration: underline; }

    @media (max-width: 720px) {
      .hero h1 { font-size: 34px; }
      .props { grid-template-columns: 1fr; }
    }
  </style>
</Base>
