{
  "name": "@sci/proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./handlers": {
      "import": "./dist/handlers/index.js"
    }
  },
  "bin": {
    "sci-proxy": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@sci/core": "*",
    "@sci/telemetry": "*",
    "hono": "^4.0.0",
    "node-forge": "^1.4.0",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14"
  }
}
