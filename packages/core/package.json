{
  "name": "@sci/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wireguard": {
      "import": "./dist/wireguard.js",
      "types": "./dist/wireguard.d.ts"
    },
    "./exposure-services": {
      "import": "./dist/exposure-services.js",
      "types": "./dist/exposure-services.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "queue": "node dist/queue-consumer.js",
    "extract-identity": "node dist/identity-extractor.js",
    "extract-identity:haiku": "SCI_EXTRACT_MODEL=anthropic/claude-haiku-4-5 node dist/identity-extractor.js",
    "extract-identity:flash": "SCI_EXTRACT_MODEL=google/gemini-flash-1.5 node dist/identity-extractor.js",
    "consolidate": "node dist/consolidation-cron.js",
    "consolidate:week": "SCI_CONSOLIDATION_WINDOW_DAYS=7 node dist/consolidation-cron.js",
    "capture-fixtures": "node ../../core/tests/capture-from-ts.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@caseyzandbergen/rate-limiter": "^1.0.0",
    "better-sqlite3": "^12.9.0",
    "compromise": "^14.15.0",
    "fastembed": "^1.14.0",
    "hnswlib-node": "^3.0.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.11.0"
  }
}
