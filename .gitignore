node_modules/
dist/
*.js.map

# Exceptions: packages whose TypeScript source lives in a separate private repo.
# These dist files are committed so the Docker build and collaborators can use
# the compiled output without needing the private source.
!packages/core/dist/
!packages/control/dist/
!packages/agent/dist/
!packages/gateway/dist/
.env
.env.local
# fastembed model cache — downloaded at runtime, not committed
local_cache/
# VitePress build output
docs/.vitepress/dist/
docs/.vitepress/cache/
# Test temp files
/tmp/sci-test*

# ── Rust workspace ───────────────────────────────────────────────────
core/target/
apps/*/target/
**/Cargo.lock.bak
core/crates/*/Cargo.lock.bak

# ── Xcode ────────────────────────────────────────────────────────────
apps/sci-mac/build/
apps/sci-mac/DerivedData/
apps/sci-mac/**/xcuserdata/
apps/sci-mac/**/*.xcuserstate
apps/sci-mac/Pods/

# ── shipped binaries (only commit source) ───────────────────────────
apps/sci-mac/SciHelper/target/
apps/sci-mac/SciTunnel/target/
