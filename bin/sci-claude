#!/usr/bin/env bash
# sci-claude — launch Claude Code routed through the sci proxy (3001 Rust helper).
#
# Why a wrapper instead of ~/.claude/settings.json `env`:
#   NODE_EXTRA_CA_CERTS is read by Node at PROCESS STARTUP, not lazily. A
#   settings.json env block is applied by Claude Code after its own node
#   process has already initialized its TLS context — too late for the sci
#   MITM CA to be trusted, so the handshake to the proxy fails. Exporting
#   here, before `exec claude`, is the only reliable way to get both the
#   proxy routing AND trust of the Sci-CA-signed leaf certs.
#
# Routes through dev.sci.helper on :3001 (Rust proxy). SCI-239 cache_control
# bug is fixed and binary rebuilt. CA = the bundle (node + helper CAs).
set -euo pipefail

PROXY="http://127.0.0.1:3001"
CA="$HOME/.sci/ca-bundle.crt"

export HTTPS_PROXY="$PROXY"
export HTTP_PROXY="$PROXY"
export https_proxy="$PROXY"
export http_proxy="$PROXY"
# Only sci/AI hosts go through the proxy; everything local bypasses it.
export NO_PROXY="127.0.0.1,localhost"
export no_proxy="127.0.0.1,localhost"
export NODE_EXTRA_CA_CERTS="$CA"

if [[ ! -f "$CA" ]]; then
  echo "✗ $CA not found — run scripts/sci-up.sh to (re)build the trust bundle." >&2
  exit 1
fi
if ! nc -z 127.0.0.1 3001 2>/dev/null; then
  echo "⚠️  sci helper not listening on :3001 (dev.sci.helper)." >&2
  echo "    Run: bash $(dirname "$0")/../scripts/sci-up.sh" >&2
fi

exec claude "$@"
