# Sci control plane — production secrets
# Copy to .env.prod and fill in real values before first deploy.
# Keep .env.prod out of git (it's in .gitignore).

# Postgres admin password (sci_admin user)
# Generate: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=change-me

# Internal token — must match SCI_INTERNAL_TOKEN on any sci-proxy/sci-gateway
# instances that call control plane internal endpoints.
# Generate: openssl rand -hex 32
SCI_INTERNAL_TOKEN=change-me

# ── DB reader/writer passwords ───────────────────────────────────────────────
# These are hardcoded in db/init.sql as sci_reader_local / sci_writer_local.
# They live on the internal Docker network so external exposure is low risk,
# but change them in init.sql before first deploy if you want stronger isolation.

# ── CA bootstrap (one-time) ──────────────────────────────────────────────────
# The control plane serves the CA cert + key to enrolling devices but does NOT
# generate them. On a fresh VPS the sci_config volume is empty, so invite/redeem
# returns caCert: null until a CA is placed at /home/sci/.sci/ca.crt + ca.key.
#
# Bootstrap steps (run once before sending any --token invites):
#   1. On your Mac, start the agent once to generate the CA:
#        sci up   # generates ~/.sci/ca.crt + ~/.sci/ca.key, then Ctrl-C
#   2. Copy the CA files to the VPS sci_config volume:
#        # find the volume mountpoint:
#        docker volume inspect sci_config
#        # then scp the files into it:
#        scp ~/.sci/ca.crt ~/.sci/ca.key user@your-vps:/path/to/volume/
#   3. Restart sci-control so it picks up the new files:
#        docker compose -f deploy/docker-compose.prod.yml restart sci-control
