server {
    listen 80;
    listen [::]:80;
    server_name dancingbits.ai www.dancingbits.ai;
    return 301 https://www.dancingbits.ai$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name dancingbits.ai www.dancingbits.ai;

    # Self-signed cert — Cloudflare terminates public TLS (Full mode).
    # Generate once on the server:
    #   openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    #     -keyout /etc/ssl/private/dancingbits.ai.key \
    #     -out /etc/ssl/certs/dancingbits.ai.crt \
    #     -subj '/CN=dancingbits.ai'
    ssl_certificate     /etc/ssl/certs/dancingbits.ai.crt;
    ssl_certificate_key /etc/ssl/private/dancingbits.ai.key;

    root {{ web_root }};
    index index.html;

    # Astro static output: serve .html files without extension
    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    # Security: block dotfiles
    location ~ /\. {
        deny all;
    }
}
